<?xml version='1.0' encoding='utf-8'?>
<project-rules>
  <code-rules>
    <file-documentation>
      <file-level-docstring>
                """
                {Clear one-line statement of this file's purpose}

                Key Components:
                    {ClassName}: {What this class does and why it exists}
                    {function_name}(): {What this function does and why it's needed}

                Project Dependencies:
                    This file uses: {OtherComponent}: {Why it's used}
                    This file is used by: {OtherComponent}: {Why it's needed}
                """
            </file-level-docstring>
      <example>
                ```python
                """
                Manages XML documentation updates for project structure.

                Key Components:
                    XMLManager: Handles reading and writing of .cursorrules XML file
                    update_rules(): Updates documentation while preserving existing rules

                Project Dependencies:
                    This file uses: ProjectScanner: To get current project structure
                    This file is used by: CLI: To execute documentation updates
                """
                
                class XMLManager:
                    ...
                ```
            </example>
    </file-documentation>
    <documentation-maintenance>
      <llm-instructions>
                Before modifying ANY file, you MUST:
                1. Read the current file-level docstring
                2. Decide if your changes affect the documentation
                3. Output your decision in this format:

                Documentation Decision:
                - Update Required: Yes/No
                - Reason: One clear sentence explaining why/why not
              - Changes Needed: [If Yes] What needs to be updated

              Actions Taken:
              -If "Yes" above, include the docstring edits in your file edits
            </llm-instructions>
      <update-triggers>
                Check if your changes involve:
                - File's main purpose changing
                - New/modified classes or functions
                - Changes to what this file uses
                - Changes to what uses this file
            </update-triggers>
    </documentation-maintenance>
    <workflow>
      <steps>
                1. READ current file-level docstring
                2. OUTPUT documentation decision
                3. MAKE code changes
                4. UPDATE docstring if needed
            </steps>
    </workflow>
  </code-rules>
  <project-map>
    <structure>
      <directory name="tests">
        <directory name="integration">
          <file name="test_scanner.py">
            <purpose>Test script for the LLM Project Companion.</purpose>
            <components>
              <component type="function" name="main">Run the project scanner on the current directory.</component>
              <component type="function" name="print_structure">Print the project structure in a readable format.</component>
            </components>
          </file>
        </directory>
      </directory>
      <directory name="src">
        <directory name="project_mapper">
          <file name="cli.py">
            <purpose>Command line interface for project-mapper.</purpose>
            <components>
              <component type="function" name="main">Main CLI entry point.</component>
            </components>
          </file>
          <directory name="core">
            <file name="scanner.py">
              <purpose>Core scanning functionality for project documentation.</purpose>
              <components>
                <component type="class" name="BaseScanner">Abstract base class for language-specific scanners.</component>
                <component type="function" name="is_supported_file">Check if file should be processed.</component>
                <component type="function" name="extract_documentation">Extract documentation from source file.</component>
                <component type="function" name="detect_dependencies">Optional dependency detection.</component>
                <component type="function" name="scan_project">Scan project directory for supported files.</component>
              </components>
            </file>
            <file name="xml_manager.py">
              <purpose>XML management for project documentation.</purpose>
              <components>
                <component type="class" name="XMLManager">Manages project documentation in XML format.</component>
                <component type="function" name="ensure_rules_file">Create or validate rules file.</component>
                <component type="function" name="update_project_map">Update project map while preserving other sections.</component>
              </components>
            </file>
          </directory>
          <directory name="adapters">
            <file name="base.py">
              <purpose>Abstract base adapter interface for language-specific scanners.</purpose>
              <components>
                <component type="class" name="BaseAdapter">Abstract base class for language-specific scanners.</component>
                <component type="function" name="is_supported_file">Check if file should be processed.</component>
                <component type="function" name="extract_documentation">Extract documentation from source file.</component>
                <component type="function" name="scan_project">Scan project directory for supported files.</component>
              </components>
            </file>
            <directory name="python">
              <file name="scanner.py">
                <purpose>Python-specific implementation of project scanner.</purpose>
                <components>
                  <component type="class" name="PythonScanner">Scanner implementation for Python projects.</component>
                  <component type="function" name="is_supported_file">Check if file is a Python source file.</component>
                  <component type="function" name="extract_documentation">Extract documentation from Python source file.</component>
                </components>
              </file>
            </directory>
          </directory>
          <directory name="git">
            <file name="hooks.py">
              <purpose>Git hook management for project-mapper.</purpose>
              <components>
                <component type="class" name="GitHookManager">Manages git hooks for project-mapper.</component>
                <component type="function" name="install_hooks">Install git hooks from templates.</component>
              </components>
            </file>
          </directory>
        </directory>
      </directory>
    </structure>
    <relationships>
      <flow description="Project documentation flow">Documentation maintained by LLM based on code analysis</flow>
    </relationships>
  </project-map>
</project-rules>