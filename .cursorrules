<?xml version='1.0' encoding='utf-8'?>
<project-rules>
  <code-rules>
    <docstrings>
      <template>
            """
            {One-line purpose}

            Components:
                {Class/Function}: {What and why}

            Dependencies:
                Uses: {Component}: {Why}
                Used By: {Component}: {Why}
            """
        </template>
    </docstrings>
    <maintenance>
      <update-triggers>
        <trigger>Purpose/functionality changes</trigger>
        <trigger>Components added/modified</trigger>
        <trigger>Dependencies shift</trigger>
        <trigger>Architecture changes</trigger>
      </update-triggers>
      <focus-points>
        <point>Why over what</point>
        <point>Key relationships</point>
        <point>Other developers perspective</point>
        <point>Architectural significance</point>
      </focus-points>
    </maintenance>
    <workflow>
      <steps>
        <step>Read existing docs</step>
        <step>Make changes</step>
        <step>Update affected docs</step>
      </steps>
      <verification>
        <check>Docstrings reflect current purpose</check>
        <check>Dependencies show key relationships</check>
        <check>Architecture is clear</check>
      </verification>
    </workflow>
  </code-rules>
  <project-map>
    <structure>
      <directory name="llm_companion">
        <file name="core.py">
          <purpose>Core functionality for scanning project structure and managing docstrings.</purpose>
          <key_components>
            <component>ProjectScanner: Core scanner for project structure and documentation.</component>
            <component>scan_project(): Scan project and return structure with docstrings.</component>
            <component>update_cursorrules(): Update .cursorrules XML file with current project structure.</component>
          </key_components>
          <dependencies>
            <outgoing>
              <dependency>CursorRulesManager: For maintaining XML documentation</dependency>
            </outgoing>
          </dependencies>
        </file>
        <file name="cursorrules_manager.py">
          <purpose>Manages .cursorrules file creation and updates, maintaining XML structure and project documentation.</purpose>
          <key_components>
            <component>CursorRulesManager: Manages .cursorrules file updates and maintains documentation standards.</component>
            <component>ensure_rules_file(): Create .cursorrules if it doesn't exist.</component>
            <component>update_project_map(): Update project-map section in .cursorrules while preserving guidelines.</component>
          </key_components>
          <dependencies>
            <outgoing>
              <dependency>ProjectScanner: For project structure analysis</dependency>
            </outgoing>
          </dependencies>
        </file>
      </directory>
    </structure>
    <relationships>
      <flow description="Project documentation process">ProjectScanner analyzes project structure and docstrings → CursorRulesManager maintains XML documentation</flow>
    </relationships>
  </project-map>
</project-rules>