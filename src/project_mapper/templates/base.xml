<?xml version='1.0' encoding='utf-8'?>
<project-rules>
  <code-rules>
    <docstrings>
      <template>
            """
            {One-line purpose}

            Components:
                {Class/Function}: {What and why}

            Dependencies:
                Uses: {Component}: {Why}
                Used By: {Component}: {Why}
            """
        </template>
    </docstrings>
    <maintenance>
      <update-triggers>
        <trigger>Purpose/functionality changes</trigger>
        <trigger>Components added/modified</trigger>
        <trigger>Dependencies shift</trigger>
        <trigger>Architecture changes</trigger>
      </update-triggers>
      <llm-check>
        Before making changes, output:
        Doc Update: [yes/no]
        Reason: [one-line explanation]
      </llm-check>
    </maintenance>
    <workflow>
      <steps>
        <step>Check triggers</step>
        <step>Output decision</step>
        <step>Make changes</step>
      </steps>
    </workflow>
  </code-rules>
  <project-map>
    <structure></structure>
    <relationships></relationships>
  </project-map>
</project-rules> 